<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ site.namn }}</title>
  <meta name="description" content="{{ beskrivning or site.beskrivning }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/atom+xml" title="{{ site.namn }}" href="/feed.xml">

  {# Så här ser sidan ut när någon delar länken i Messenger, Slack eller på Facebook #}
  <meta property="og:type" content="{% if page.url and '/guider/' in page.url and page.url != '/guider/' %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.namn }}">
  <meta property="og:locale" content="sv_SE">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ beskrivning or site.beskrivning }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/bilder/delningsbild.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
</head>
<body>

  <header class="sidhuvud">
    <a class="logga" href="/">Barnprylsdoktorn</a>
    <nav class="navbar">
      <a href="/" {% if page.url == "/" %}class="aktiv"{% endif %}>Hem</a>
      <a href="/guider/" {% if "/guider/" in page.url %}class="aktiv"{% endif %}>Guider</a>
      <a href="/om/" {% if page.url == "/om/" %}class="aktiv"{% endif %}>Om</a>
    </nav>
  </header>

  <main>
    {% if kicker %}<span class="kicker">{{ kicker }}</span>
    {%- elif "/guider/" in page.url and page.url != "/guider/" %}<span class="kicker">Guide</span>{% endif %}
    <h1>{{ title | typo }}</h1>
    {% if ingress %}<p class="ingress">{{ ingress | typo }}</p>{% endif %}
    {%- if date and "/guider/" in page.url and page.url != "/guider/" %}
    <p class="datum"><time datetime="{{ date | htmlDateString }}">Senast uppdaterad {{ date | datum }}</time></p>
    {%- endif %}
    {{ content | safe }}

    {%- if "/guider/" in page.url and page.url != "/guider/" %}
    {#- Köpguiden först när den är relevant: läsaren som just förstått reglerna
        är i det läge där hon vill veta vilken stol hon faktiskt ska köpa. -#}
    {%- set ovriga = [] %}
    {%- for artikel in collections.artiklar %}
      {%- if artikel.url != page.url and "vilken-ska-jag-kopa" in artikel.url %}
        {%- set ovriga = (ovriga.push(artikel), ovriga) %}
      {%- endif %}
    {%- endfor %}
    {%- for artikel in collections.artiklar | reverse %}
      {%- if artikel.url != page.url and "vilken-ska-jag-kopa" not in artikel.url and ovriga.length < 2 %}
        {%- set ovriga = (ovriga.push(artikel), ovriga) %}
      {%- endif %}
    {%- endfor %}
    {%- if ovriga.length %}
    <aside class="las-harnast">
      <h2>Läs härnäst</h2>
      <ul>
        {%- for artikel in ovriga %}
        <li><a href="{{ artikel.url }}">{{ artikel.data.title | typo }}</a></li>
        {%- endfor %}
      </ul>
    </aside>
    {%- endif %}
    {%- endif %}
  </main>

  <footer class="sidfot">
    <p><strong>Barnprylsdoktorn</strong> — skriven av en förälder som googlade för mycket.</p>
    <p><a href="/guider/">Guider</a> &middot; <a href="/om/">Om sajten</a> &middot; <a href="/feed.xml">RSS</a></p>
    <p class="finstilt">Vissa länkar är affiliatelänkar. Det påverkar inte vad vi rekommenderar. Innehållet ersätter inte tillverkarens monteringsanvisning.</p>
  </footer>

</body>
</html>
