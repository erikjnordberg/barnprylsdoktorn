<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ site.namn }}</title>
  <meta name="description" content="{{ beskrivning or site.beskrivning }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {# Typsnitten ligger på vår egen server — inga anrop till Google, och en
     uppkoppling mindre innan sidan kan ritas. Rubrikfonten laddas i förväg
     eftersom den behövs direkt för h1. #}
  <link rel="preload" href="/fonter/playfair-display-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonter/source-sans-3-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/css/style.css' | version }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.namn }}" href="/feed.xml">

  {# Så här ser sidan ut när någon delar länken i Messenger, Slack eller på Facebook #}
  <meta property="og:type" content="{% if page.url and '/guider/' in page.url and page.url != '/guider/' %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.namn }}">
  <meta property="og:locale" content="sv_SE">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ beskrivning or site.beskrivning }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ '/bilder/delningsbild.png' | version }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">

  {%- if date and "/guider/" in page.url and page.url != "/guider/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump | safe }},
    "description": {{ (beskrivning or site.beskrivning) | dump | safe }},
    "image": {{ (site.url ~ ("/bilder/delningsbild.png" | version)) | dump | safe }},
    "author": {
      "@type": "Person",
      "name": "Erik Nordberg"
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ site.namn | dump | safe }}
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ (site.url ~ page.url) | dump | safe }}
    },
    "datePublished": {{ (date | isoDate) | dump | safe }},
    "dateModified": {{ ((uppdaterad or date) | isoDate) | dump | safe }}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Hem",
        "item": {{ site.url | dump | safe }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Guider",
        "item": {{ (site.url ~ "/guider/") | dump | safe }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ title | dump | safe }},
        "item": {{ (site.url ~ page.url) | dump | safe }}
      }
    ]
  }
  </script>
  {%- endif %}
</head>
<body>

  <header class="sidhuvud">
    <a class="logga" href="/">Barnprylsdoktorn</a>
    <nav class="navbar">
      <a href="/" {% if page.url == "/" %}class="aktiv"{% endif %}>Hem</a>
      <a href="/guider/" {% if "/guider/" in page.url %}class="aktiv"{% endif %}>Guider</a>
      <a href="/om/" {% if page.url == "/om/" %}class="aktiv"{% endif %}>Om</a>
    </nav>
  </header>

  <main>
    {% if kicker %}<span class="kicker">{{ kicker }}</span>
    {%- elif "/guider/" in page.url and page.url != "/guider/" %}<a class="kicker" href="/guider/">Guide</a>{% endif %}
    <h1>{{ title | typo }}</h1>
    {% if ingress %}<p class="ingress">{{ ingress | typo }}</p>{% endif %}
    {%- if date and "/guider/" in page.url and page.url != "/guider/" %}
    <p class="datum">Av Erik Nordberg &middot; Publicerad <time datetime="{{ date | htmlDateString }}">{{ date | datum }}</time>{%- if uppdaterad and (uppdaterad | htmlDateString) != (date | htmlDateString) %} &middot; Uppdaterad <time datetime="{{ uppdaterad | htmlDateString }}">{{ uppdaterad | datum }}</time>{%- endif %}</p>
    {%- endif %}
    {{ content | safe }}

    {%- if "/guider/" in page.url and page.url != "/guider/" %}
    {#- Köpguiden först när den är relevant: läsaren som just förstått reglerna
        är i det läge där hon vill veta vilken stol hon faktiskt ska köpa. -#}
    {%- set ovriga = [] %}
    {%- for artikel in collections.artiklar %}
      {%- if artikel.url != page.url and "vilken-ska-jag-kopa" in artikel.url %}
        {%- set ovriga = (ovriga.push(artikel), ovriga) %}
      {%- endif %}
    {%- endfor %}
    {%- for artikel in collections.artiklar | reverse %}
      {%- if artikel.url != page.url and "vilken-ska-jag-kopa" not in artikel.url and ovriga.length < 2 %}
        {%- set ovriga = (ovriga.push(artikel), ovriga) %}
      {%- endif %}
    {%- endfor %}
    {%- if ovriga.length %}
    <aside class="las-harnast">
      <h2>Läs härnäst</h2>
      <ul>
        {%- for artikel in ovriga %}
        <li><a href="{{ artikel.url }}">{{ artikel.data.title | typo }}</a></li>
        {%- endfor %}
      </ul>
    </aside>
    {%- endif %}
    {%- endif %}
  </main>

  <footer class="sidfot">
    <p><strong>Barnprylsdoktorn</strong> — skriven av Erik Nordberg, en förälder som googlade för mycket.</p>
    <p><a href="/guider/">Guider</a> &middot; <a href="/om/">Om sajten</a> &middot; <a href="/sa-tjanar-sajten-pengar/">Så tjänar sajten pengar</a> &middot; <a href="/feed.xml">RSS</a></p>
    <p class="finstilt">Vissa länkar är affiliatelänkar. Det påverkar inte vad vi rekommenderar. Innehållet ersätter inte tillverkarens monteringsanvisning.</p>
  </footer>

</body>
</html>
